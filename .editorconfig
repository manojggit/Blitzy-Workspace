root = true

# EditorConfig, https://editorconfig.org
# MK_Modernization Rule, formatting clause: 4-space indentation, never tabs, 100-character lines.
# These values match [tool.ruff] in backend/ and batch/pyproject.toml and the Prettier settings
# in frontend/.prettierrc.json; this file carries them to SQL, Markdown, YAML, JSON and shell.

# trim_trailing_whitespace is left unset on purpose: fixed-width records and expected-output
# fixtures hold trailing spaces that are compared byte for byte.
[*]
indent_style = space
indent_size = 4
max_line_length = 100
end_of_line = lf
charset = utf-8
insert_final_newline = true

# Legacy mainframe trees are read-only reference inputs: CRLF fixed-column COBOL, JCL and BMS
# text, binary code-page-037 images, and ASCII records with significant trailing spaces and a
# lone-LF final record in two files. Every editor action that could rewrite their bytes is off.
# app-* covers the three optional extension folders (app-authorization-ims-db2-mq,
# app-transaction-type-db2, app-vsam-mq) and keeps the section header within 100 characters.
[{cbl,cpy,cpy-bms,bms,jcl,proc,ctl,asm,maclib,data,scheduler,catlg,csd,app-*}/**]
indent_style = unset
indent_size = unset
max_line_length = off
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = false

# Expected batch outputs are LF-terminated fixed-width records (80, 100, 133, 350 and 430 bytes)
# with significant trailing spaces, compared byte for byte: editors neither wrap, trim nor append.
[batch/tests/fixtures/expected/**]
max_line_length = off
insert_final_newline = unset
trim_trailing_whitespace = false
