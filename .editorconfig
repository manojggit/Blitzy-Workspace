root = true

# EditorConfig, https://editorconfig.org
# MK_Modernization Rule, formatting clause: 4-space indentation, never tabs, 100-character lines.
# These values match [tool.ruff] in backend/ and batch/pyproject.toml and the Prettier settings
# in frontend/.prettierrc.json; this file carries them to SQL, Markdown, YAML, JSON and shell.

# trim_trailing_whitespace is left unset on purpose: fixed-width records and expected-output
# fixtures hold trailing spaces that are compared byte for byte.
[*]
indent_style = space
indent_size = 4
max_line_length = 100
end_of_line = lf
charset = utf-8
insert_final_newline = true

# Legacy mainframe trees are read-only reference inputs: CRLF fixed-column COBOL, JCL and BMS
# text, binary code-page-037 images, and ASCII records with significant trailing spaces and a
# lone-LF final record in two files. The [*] indentation, line-ending, charset and final-newline
# settings are unset, leaving editor defaults; the 100-column limit is off and trailing spaces stay.
# app-* covers the three optional extension folders (app-authorization-ims-db2-mq,
# app-transaction-type-db2, app-vsam-mq) and keeps the section header within 100 characters.
[{cbl,cpy,cpy-bms,bms,jcl,proc,ctl,asm,maclib,data,scheduler,catlg,csd,app-*}/**]
indent_style = unset
indent_size = unset
max_line_length = off
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = false

# Expected batch outputs. The STATEMNT.PS, STATEMNT.HTML, tranrept_lines.txt and .dat fixtures
# hold LF-terminated fixed-width records (80, 100, 133, and 350 or 430 bytes) with significant
# trailing spaces, compared byte for byte; the CSVs hold variable-width rows, compared field for
# field. The 100-column limit is off, trailing spaces stay and the final newline is left to the
# editor; the [*] indentation, line-ending and charset settings still apply.
[batch/tests/fixtures/expected/**]
max_line_length = off
insert_final_newline = unset
trim_trailing_whitespace = false
