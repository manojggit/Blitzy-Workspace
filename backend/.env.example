# CardDemo backend environment template.
#
# Copy this file to backend/.env and set SECRET_KEY. Every other value works as it stands for
# local development against the Compose db service:
#
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored and must never be committed. Process environment variables
# override its values. The backend settings, Alembic, the carddemo-batch CLI and the test
# suites read it; batch and Alembic need no SECRET_KEY. Write one KEY=value per line, with no
# quotes, no "export" and no spaces around "=".

# --- Runtime mode ------------------------------------------------------------------------------
# production makes the session cookie Secure, turns the API docs off unless ENABLE_API_DOCS is
# true, skips the sample-data seed of Alembic revision 0002, and makes
# "carddemo-batch load init-users" refuse to run.

# Deployment mode: local (default), test (set by the test suites) or production.
APP_ENV=local

# --- Database (SQLAlchemy URLs) ----------------------------------------------------------------
# Both URLs take the form DRIVER://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME. The
# carddemo/carddemo credentials are local development example values that match the Compose
# db service defaults; replace them for any other database. Use the host 127.0.0.1, not
# localhost, which may resolve to the IPv6 address ::1 first.

# Async engine of the FastAPI runtime; required; DRIVER is postgresql+asyncpg.
DATABASE_URL=postgresql+asyncpg://carddemo:carddemo@127.0.0.1:5432/carddemo
# Sync engine of Alembic and the batch CLI; required; DRIVER is postgresql+psycopg2.
SYNC_DATABASE_URL=postgresql+psycopg2://carddemo:carddemo@127.0.0.1:5432/carddemo
# Seconds to wait for a new database connection; finite positive number; default 10.
DB_CONNECT_TIMEOUT_SECONDS=10
# Seconds a single database statement may run; finite positive number; default 30.
DB_COMMAND_TIMEOUT_SECONDS=30

# --- Session and security ----------------------------------------------------------------------
# SECRET_KEY is blank on purpose: the backend refuses to start while it is blank or shorter
# than 32 characters. It signs the HS256 session cookie and derives, through HKDF-SHA256, the
# Fernet keys of the card_ref and screen_token navigation tokens. Generate one with:
#
#     openssl rand -hex 32

# Set to SECRET_KEY_VALUE: required, at least 32 characters, e.g. output of openssl rand -hex 32.
SECRET_KEY=
# Session cookie Max-Age and card_ref/screen_token lifetime, in minutes; positive; default 60.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Name of the HttpOnly session cookie; default carddemo_session.
SESSION_COOKIE_NAME=carddemo_session
# bcrypt cost factor for password hashes; 4 to 31; default 12.
BCRYPT_ROUNDS=12
# Failed sign-ons before a user ID is locked out; positive integer; default 5.
LOGIN_MAX_ATTEMPTS=5
# Lockout length in seconds once LOGIN_MAX_ATTEMPTS is reached; positive integer; default 900.
LOGIN_LOCKOUT_SECONDS=900

# --- HTTP --------------------------------------------------------------------------------------
# Every origin in BACKEND_CORS_ORIGINS is allowed for CORS with credentials and passes the
# OriginGuard CSRF check on POST, PUT and DELETE. Each must equal the browser origin exactly:
# http://localhost:3000 is a different site from http://127.0.0.1:3000.
#
# ENABLE_API_DOCS stays commented out. An empty value, here or in the process environment, is
# skipped like an unset one. While no source sets ENABLE_API_DOCS, /docs, /redoc and
# /openapi.json are served whenever APP_ENV is not production, and never in production.

# Allowed frontend origins, comma-separated as ORIGIN_1,ORIGIN_2; default http://127.0.0.1:3000.
BACKEND_CORS_ORIGINS=http://127.0.0.1:3000
# Seconds the SELECT 1 of GET /health/ready may take; finite positive number; default 2.
HEALTH_READY_TIMEOUT_SECONDS=2
# Forces the API docs on or off: true or false; unset (default) follows APP_ENV.
# ENABLE_API_DOCS=true

# --- Data and output directories ---------------------------------------------------------------
# A relative path resolves against the repository root, never the working directory. An
# absolute path is used unchanged.

# EBCDIC seed images read by Alembic revision 0002 and the batch loaders; default data/EBCDIC.
CARDDEMO_EBCDIC_DIR=data/EBCDIC
# ASCII seed images, read when a batch loader runs with --encoding ascii; default data/ASCII.
CARDDEMO_ASCII_DIR=data/ASCII
# Batch GDG archives and statements; not read by the backend runtime; default var/batch-output.
CARDDEMO_OUTPUT_DIR=var/batch-output

# --- Tests (optional) --------------------------------------------------------------------------
# The backend and batch test suites read these. When unset, they derive them from DATABASE_URL
# and SYNC_DATABASE_URL with the database name carddemo_test, which
# docker/postgres/init-test-db.sql creates. Tests generate their own SECRET_KEY.

# Async test database URL; default DATABASE_URL with the database carddemo_test.
# TEST_DATABASE_URL=postgresql+asyncpg://carddemo:carddemo@127.0.0.1:5432/carddemo_test
# Sync test database URL; default SYNC_DATABASE_URL with the database carddemo_test.
# TEST_SYNC_DATABASE_URL=postgresql+psycopg2://carddemo:carddemo@127.0.0.1:5432/carddemo_test

# --- Docker Compose ----------------------------------------------------------------------------
# docker-compose.yml reads POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB from the shell
# environment, not from this file. Each defaults to carddemo and must match the credentials in
# the database URLs above, so do not add them here. Under the full profile, Compose loads this
# file's copy and overrides the database URLs (host db), the data and output directories and
# BACKEND_CORS_ORIGINS.
