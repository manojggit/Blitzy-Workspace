# End-to-end test settings for the Playwright suite in frontend/e2e.
#
# Copy this template to frontend/.env.e2e, which the root .gitignore keeps
# out of git, then fill in the four blank sign-on values:
#
#     cp frontend/.env.e2e.example frontend/.env.e2e
#
# Every URL uses the host 127.0.0.1, never localhost: a browser treats the
# two as different sites and would not send the session cookie.
#
# Warning: the e2e global setup runs `carddemo-batch seed-all`, which resets
# the local carddemo database.

# Frontend origin the browser opens; Playwright's baseURL.
CARDDEMO_E2E_BASE_URL=http://127.0.0.1:3000

# Backend origin; global setup waits for its /health/ready probe.
CARDDEMO_E2E_API_URL=http://127.0.0.1:8000

# Sign-on credentials. Each user must exist after `carddemo-batch seed-all`,
# for example the legacy sample users loaded from
# data/EBCDIC/AWS.M2.CARDDEMO.USRSEC.PS. docs/README.md names their IDs and
# says where their password comes from. Never commit a value here: user IDs
# and passwords belong only in the uncommitted frontend/.env.e2e.

# Regular user: any user type other than A, so sign-on opens the main menu.
CARDDEMO_E2E_USER_ID=
CARDDEMO_E2E_PASSWORD=

# Admin user: user type A, so sign-on opens the admin menu.
CARDDEMO_E2E_ADMIN_ID=
CARDDEMO_E2E_ADMIN_PASSWORD=

# The two relative paths below resolve against the repository root, not
# frontend/. Global setup resolves them with
# path.resolve(__dirname, '..', '..') and passes the output directory to the
# batch CLI as an absolute path.

# Batch CLI that the global setup and the day-in-the-life flow run.
CARDDEMO_BATCH_BIN=.venv/bin/carddemo-batch

# Batch output root: the GDG archives and statements/STATEMNT.PS.
CARDDEMO_OUTPUT_DIR=var/batch-output
